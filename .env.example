# A Postgres connection string — same database for local dev and the
# published app. Get one free from Neon, Supabase, or Vercel's own Postgres
# storage integration.
DATABASE_URL="postgresql://user:password@host:5432/account_suite"

# Secret used to sign login sessions. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this secret and never commit a real value — a placeholder ships here on
# purpose so the app refuses to start until you set your own. Use a different
# secret for local dev vs. a publicly hosted instance.
AUTH_SECRET="replace-with-your-own-random-secret"
