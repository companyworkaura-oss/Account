# A Postgres connection string — same database for local dev and the
# published app. Get one free from Neon, Supabase, or Vercel's own Postgres
# storage integration.
DATABASE_URL="postgresql://user:password@host:5432/account_suite"

# A second, non-pooled connection to the SAME database, used only by
# `prisma db push`/migrate (pooled connections don't support the prepared
# statements those commands need). Neon's Vercel integration creates this
# automatically as DATABASE_URL_UNPOOLED — copy that value here too.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/account_suite"

# Secret used to sign login sessions. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this secret and never commit a real value — a placeholder ships here on
# purpose so the app refuses to start until you set your own. Use a different
# secret for local dev vs. a publicly hosted instance.
AUTH_SECRET="replace-with-your-own-random-secret"

# Optional: lets people sign in with Google instead of a password. Only
# works for emails you've already added under Users in the app — it's an
# alternative login method, not open sign-up. Leave both unset to skip
# Google entirely (the app works fine without it). See README for how to
# get these from Google Cloud Console.
# AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="your-client-secret"
