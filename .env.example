# Local (default): SQLite file stored on this PC
DATABASE_URL="file:./dev.db"

# Secret used to sign login sessions. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this secret and never commit a real value — a placeholder ships here on
# purpose so the app refuses to start until you set your own.
AUTH_SECRET="replace-with-your-own-random-secret"

# When you are ready to publish/host the app, switch to a hosted database
# and change the datasource provider in prisma/schema.prisma from
# "sqlite" to "postgresql" (or "mysql"), then run `npx prisma db push`.
# Example (Postgres):
# DATABASE_URL="postgresql://user:password@host:5432/account_suite"
